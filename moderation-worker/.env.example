# Copy to .env and fill in. The service role key is SECRET — server-only.
SUPABASE_URL=https://nvywxqntsrlrmlrpfuub.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
POLL_INTERVAL_MS=5000
# Idle backoff ceiling: when the queue is empty the poll delay ramps up to this
# instead of polling every POLL_INTERVAL_MS forever (which quietly burns egress).
IDLE_POLL_INTERVAL_MS=30000
BATCH=5
